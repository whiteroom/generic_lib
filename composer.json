{
    "name": "whiteroom/generic_lib",
    "type": "typo3-cms-extension",
    "description": "Extension kick starting a full site",
    "homepage": "https://whiteroom.ch/",
    "keywords": [
        "TYPO3",
        "CMS",
        "extension"
    ],
    "authors": [
        {
            "name": "whiteroom",
            "role": "Developer",
            "homepage": "https://whiteroom.ch/"
        }
    ],
    "license": [
        "GPL-2.0-or-later"
    ],
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3",
        "typo3/cms-core": "^12.4 || ^13.4",
        "typo3/cms-impexp": "^12.4 || ^13.4",
        "typo3/cms-indexed-search": "^12.4 || ^13.4",
        "georgringer/news": "^11.0 || ^12.0 || ^13.0 || ^14.0"
    },
    "autoload": {
        "psr-4": {
            "Whiteroom\\GenericLib\\": "Classes/"
        }
    },
    "replace": {
        "generic_lib": "self.version",
        "typo3-ter/generic_lib": "self.version"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "generic_lib"
        }
    }
}
